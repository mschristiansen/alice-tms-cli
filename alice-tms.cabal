cabal-version: 2.4
name:          alice-tms
version:       0.1.0.0
synopsis:      CLI client for the Alice TMS API
license:       BSD-3-Clause
build-type:    Simple

common common-deps
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:
    , base            >= 4.17 && < 5
    , aeson           >= 2.0
    , bytestring      >= 0.11
    , http-client     >= 0.7
    , http-client-tls >= 0.3
    , http-types      >= 0.12
    , text            >= 2.0
    , time            >= 1.12

library
  import:          common-deps
  hs-source-dirs:  src
  exposed-modules:
    AliceTMS.Booking
    AliceTMS.CLI
    AliceTMS.Client
    AliceTMS.Config
    AliceTMS.Error
    AliceTMS.Types.Request
    AliceTMS.Types.Response
    AliceTMS.Validation
  other-modules:
    AliceTMS.Internal.JSON
  build-depends:
    , optparse-applicative >= 0.17

executable alice-tms
  import:          common-deps
  hs-source-dirs:  app
  main-is:         Main.hs
  build-depends:
    , alice-tms
    , dotenv       >= 0.11
    , directory    >= 1.3
  ghc-options:     -threaded
